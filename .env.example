# Optional local build overrides: copy this file to .env if needed.
# Precedence: versions.env -> .env -> shell environment -> PowerShell arguments.
# Plain KEY=VALUE only; no shell commands, interpolation or inline comments.

# Empty derives <VLLM_IMAGE_REPOSITORY>:v<VLLM_VERSION>-cu128.
VLLM_IMAGE=

# Change related versions together in versions.env; an override is also allowed.
# VLLM_VERSION=0.31.0
# TORCH_CUDA_ARCH_LIST=9.0;12.0

# Lower compile parallelism when memory is limited.
# TORCH_MAX_JOBS=2
# VLLM_MAX_JOBS=2
# NVCC_THREADS=1

# Optional existing host cache used only by scripts/finish-build.ps1.
# No model weights are included in this repository.
# VLLM_CACHE_DIR=./.cache/huggingface
