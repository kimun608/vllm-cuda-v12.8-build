# syntax=docker/dockerfile:1.7
# Optional CUDA12.8 overlay. Original native packages and runtime are inherited.
# Build context may be this artifact directory or the matching published Git layout.
ARG BASE_IMAGE=lottecard/vllm-openai:v0.32.0-cu128
FROM ${BASE_IMAGE}
ARG EXPECTED_COMPILATION_SOURCE_SHA256=d8a8086166e3f344b75d98d8350a77592f7b6c145319b3a9f0b9c8cb36bc39cb
ARG EXPECTED_COMPILER_SOURCE_SHA256=1a744fd54db9e67c8bd58d34431d034ee5b32df92afb34101bb5980c09452b91
COPY scripts/patch-small-gemm-autotune-v3.py /opt/patch-small-gemm-autotune-v3.py
# Inherit /vllm-workspace, ENTRYPOINT and native provenance from the selected base.
RUN test "$PWD" = /vllm-workspace \
    && test -n "${EXPECTED_COMPILATION_SOURCE_SHA256}" \
    && test -n "${EXPECTED_COMPILER_SOURCE_SHA256}" \
    && printf '%s  %s\n' 'e8e62249d17b370db42b088caefd2677b78b18247c1dbdf2db97f90ec6d34e2c' /opt/patch-small-gemm-autotune-v3.py | sha256sum --check --status \
    && OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 python3 -B -E -c 'import json,os,re,subprocess,torch; from pathlib import Path; assert torch.version.cuda=="12.8", "BASE_IMAGE Torch must use CUDA12.8"; assert torch.cuda.is_initialized() is False, "CPU preflight must not initialize CUDA"; names=("TRITON_PTXAS_PATH","TRITON_PTXAS_BLACKWELL_PATH"); paths={name:Path(os.environ[name]) for name in names}; assert all(path.is_absolute() and path.is_file() for path in paths.values()), "Both ptxas overrides must be existing absolute paths"; versions={name:subprocess.check_output([str(path),"--version"],text=True,stderr=subprocess.STDOUT,timeout=30).strip() for name,path in paths.items()}; assert all(re.search(r"\brelease\s+12\.8(?:[,\s]|$)",value,re.I) for value in versions.values()), "Both Triton ptxas paths must report release12.8"; assert torch.cuda.is_initialized() is False; info={"torch":str(torch.__version__),"torch_cuda":torch.version.cuda,"cuda_initialized":False,"ptxas":{name:{"path":str(paths[name]),"version":versions[name]} for name in names},"inherited_torch_gemm_environment":{name:os.environ.get(name) for name in ("TORCHINDUCTOR_MAX_AUTOTUNE_GEMM","TORCHINDUCTOR_MAX_AUTOTUNE_GEMM_BACKENDS")}}; Path("/opt/small-gemm-base-validation.json").write_text(json.dumps(info,indent=2)+"\n",encoding="utf-8"); print(json.dumps(info))' \
    && python3 -B -E /opt/patch-small-gemm-autotune-v3.py --mode apply \
        --compilation-source /opt/.venv/lib/python3.12/site-packages/vllm/config/compilation.py \
        --compiler-source /opt/.venv/lib/python3.12/site-packages/vllm/compilation/compiler_interface.py \
        --expected-compilation-sha256 "${EXPECTED_COMPILATION_SOURCE_SHA256}" \
        --expected-compiler-sha256 "${EXPECTED_COMPILER_SOURCE_SHA256}" \
        --metadata /opt/small-gemm-autotune-v3-patch.json
ENV LOTTECARD_GEMM_AUTOTUNE_SIZES=1
LABEL com.lottecard.vllm.optimization="small-capture-gemm-v3-upto16"
