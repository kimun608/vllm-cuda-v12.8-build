# Central build versions. Change these together for an upstream-compatible stack.
# Plain KEY=VALUE only; no shell commands or variable interpolation.
VLLM_VERSION=0.32.0
TORCH_VERSION=2.13.0
TORCHVISION_VERSION=0.28.0
TORCHAUDIO_VERSION=2.11.0
TRITON_VERSION=3.7.1
TORCHCODEC_VERSION=0.14.0
RUST_VERSION=1.95
CUDA_BASE=nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04
# Optional full commit SHA: an empty value uses the selected release tag.
VLLM_COMMIT=
TORCH_COMMIT=
TORCHVISION_COMMIT=
TORCHAUDIO_COMMIT=
# Older vLLM releases can use different extension module names.
VLLM_REQUIRED_EXTENSIONS=_C_stable_libtorch,_moe_C_stable_libtorch
TORCH_CUDA_ARCH_LIST=9.0;12.0
MAX_JOBS=2
TORCH_MAX_JOBS=2
VLLM_MAX_JOBS=2
NVCC_THREADS=1
VLLM_IMAGE_REPOSITORY=lottecard/vllm-openai
# Empty: derive <repository>:v<VLLM_VERSION>-cu128.
VLLM_IMAGE=
